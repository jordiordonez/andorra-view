# Copy to .env (never commit .env). Everything is optional: the app runs with no keys at all.

# --- Browser-visible (VITE_*) — restrict by HTTP referrer in each provider console ---------------
# Base URL of the API proxy when the frontend is not served by the same origin (e.g. GitHub Pages):
# VITE_API_BASE=https://andorra-view-api.<your-account>.workers.dev
VITE_API_BASE=
# Optional Cesium ion token → Cesium World Terrain instead of the Govern DTM + Terrarium composite.
VITE_CESIUM_ION_TOKEN=
# Optional Google Maps Platform key with Map Tiles API enabled → "Fotorealista 3D" toggle.
VITE_GOOGLE_MAPS_API_KEY=

# --- Server-side only (used by `npm run dev` middleware and the Cloudflare Worker) -----------------
# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenSky Network OAuth2 client credentials (optional fallback for aircraft):
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Contact info appended to the upstream User-Agent (URL or email of the operator):
CONTACT=
